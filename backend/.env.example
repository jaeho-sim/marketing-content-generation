# Copy to .env and fill in real values

# Database (overridden inside docker-compose containers)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketing_content
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/marketing_content

# GCS
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=marketing-content-media
GCS_PRESIGNED_URL_EXPIRY_SECONDS=3600
# Local dev only — set to use fake-gcs-server instead of real GCS.
# docker-compose sets STORAGE_EMULATOR_HOST automatically inside the container.
# STORAGE_EMULATOR_HOST=http://localhost:4443

# Pub/Sub
PUBSUB_TOPIC=media-uploaded
# Shared secret appended as ?token= to the Pub/Sub push subscription URL
PUBSUB_WEBHOOK_TOKEN=change-me-in-production

# LLM provider — "gemini" (free) or "claude"
LLM_PROVIDER=gemini

# Google Gemini — free tier, get key at https://aistudio.google.com/apikey
# On Cloud Run you can leave GEMINI_API_KEY empty and use ADC instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude (only needed when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Whisper
WHISPER_MODEL_SIZE=base

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=["http://localhost:3000"]
